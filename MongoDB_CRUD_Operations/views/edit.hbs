<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main class="page narrow">
        <header class="page-header">
            <p class="eyebrow">MongoDB CRUD demo</p>
            <h1>Edit task</h1>
            <p class="subtitle">Update the task details and save your changes.</p>
        </header>
        <section class="panel">
            {{#if error}}<p class="notice error" role="alert">{{error}}</p>{{/if}}
            <form action="/tasks/{{task.id}}/edit" method="post" class="task-form">
                <label for="title">Task title</label>
                <input id="title" name="title" type="text" maxlength="120" required value="{{task.title}}">

                <label for="description">Description <span class="optional">(optional)</span></label>
                <textarea id="description" name="description" rows="5" maxlength="1000">{{task.description}}</textarea>

                <div class="form-actions">
                    <button class="button primary" type="submit">Save changes</button>
                    <a class="button secondary" href="/">Cancel</a>
                </div>
            </form>
        </section>
    </main>
</body>
</html>

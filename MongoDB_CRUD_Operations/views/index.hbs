<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main class="page">
        <header class="page-header">
            <p class="eyebrow">MongoDB CRUD demo - Ganesh Bhat</p>
            <h1>Task board</h1>
            <p class="subtitle">Create, edit, complete, and delete tasks stored in MongoDB.</p>
        </header>

        <section class="panel" aria-labelledby="new-task-heading">
            <h2 id="new-task-heading">Add a task</h2>
            {{#if error}}<p class="notice error" role="alert">{{error}}</p>{{/if}}
            <form action="/tasks" method="post" class="task-form">
                <label for="title">Task title</label>
                <input id="title" name="title" type="text" maxlength="120" required value="{{form.title}}" placeholder="e.g. Review MongoDB CRUD">

                <label for="description">Description <span class="optional">(optional)</span></label>
                <textarea id="description" name="description" rows="3" maxlength="1000" placeholder="Add a few details">{{form.description}}</textarea>

                <button class="button primary" type="submit">Add task</button>
            </form>
        </section>

        <section class="tasks-section" aria-labelledby="tasks-heading">
            <div class="section-heading">
                <h2 id="tasks-heading">Your tasks</h2>
                <span class="count">{{tasks.length}}</span>
            </div>

            {{#if tasks.length}}
                <ul class="task-list">
                    {{#each tasks}}
                        <li class="task-card {{#if completed}}is-complete{{/if}}">
                            <div class="task-content">
                                <div class="task-title-row">
                                    <h3>{{title}}</h3>
                                    {{#if completed}}<span class="status">Complete</span>{{else}}<span class="status pending">In progress</span>{{/if}}
                                </div>
                                {{#if description}}<p class="description">{{description}}</p>{{/if}}
                                <p class="created">Added {{createdAtLabel}}</p>
                            </div>
                            <div class="task-actions">
                                <form action="/tasks/{{id}}/toggle" method="post">
                                    <button class="button secondary" type="submit">{{#if completed}}Reopen{{else}}Complete{{/if}}</button>
                                </form>
                                <a class="button secondary" href="/tasks/{{id}}/edit">Edit</a>
                                <form action="/tasks/{{id}}/delete" method="post" onsubmit="return confirm('Delete this task?')">
                                    <button class="button danger" type="submit">Delete</button>
                                </form>
                            </div>
                        </li>
                    {{/each}}
                </ul>
            {{else}}
                <div class="empty-state">
                    <h3>No tasks yet</h3>
                    <p>Add your first task above. It will be saved in MongoDB.</p>
                </div>
            {{/if}}
        </section>
        <footer>Node.js · Express · Handlebars · MongoDB Node.js driver</footer>
    </main>
</body>
</html>
